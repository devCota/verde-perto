{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "verdeperto": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/leaflet/dist/leaflet.css",
              "src/styles.css"
            ],
            "outputPath": "dist/verdeperto"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "demo": {
              "fileReplacements": [
                {
                  "replace": "src/app/runtime.ts",
                  "with": "src/app/runtime.demo.ts"
                }
              ],
              "baseHref": "./",
              "outputPath": "dist/demo"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "verdeperto:build:development"
            },
            "demo": {
              "buildTarget": "verdeperto:build:development,demo"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
